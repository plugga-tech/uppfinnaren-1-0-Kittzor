@model List<Uppfinnaren.Models.Alster>

<div>
    @foreach (var alster in Model)
    {
        <div style="margin-bottom: 20px;">
            <h2>@alster.Name</h2>
            <p>@alster.Description</p>
            <img src="@alster.ImageUrl" alt="@alster.Name" style="width:200px;height:auto;" />
        </div>
    }
</div>